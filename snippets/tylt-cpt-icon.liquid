{%- comment -%}
  Renders a keyword-matched SVG icon for a formation title, mirroring
  get_icon_for_title() from acf-blocks/cpt-list/view.php.
  Usage: {% render 'tylt-cpt-icon', title: block.settings.title %}
{%- endcomment -%}

{%- liquid
  assign t = title | downcase
  assign icon = 'base_web'
  if t contains 'shopify'
    assign icon = 'shopify'
  elsif t contains 'wordpress'
    assign icon = 'wordpress'
  elsif t contains 'ui' or t contains 'ux'
    assign icon = 'ui_ux'
  elsif t contains 'base web'
    assign icon = 'base_web'
  elsif t contains 'conception 3d'
    assign icon = 'conception_3d'
  elsif t contains 'impression 3d'
    assign icon = 'impression_3d'
  endif
-%}

<span class="tylt-menu-icon-svg">

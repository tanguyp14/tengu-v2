{%- render 'tylt-page-title', title: article.title -%}

<div class="tylt-page-content tylt-article-header-content">
  {%- if article.image != blank -%}
    <div class="tylt-article-image">
      {{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600,900,1200,1600' }}
    </div>
  {%- endif -%}

  {%- if article.tags.size > 0 -%}
    <div class="tylt-cpt-card-tags tylt-article-tags">
      {{ article.tags | join: ' - ' }}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "TYLT Article Header",
  "settings": []
}
{% endschema %}

{%- liquid
  assign is_home = false
  if template.name == 'index'
    assign is_home = true
  endif
-%}

<div class="tylt-branding">
  <a href="{{ routes.root_url }}" class="tylt-logo-link">
    {%- if section.settings.logo != blank -%}
      {{ section.settings.logo | image_url: width: 400 | image_tag: loading: 'eager' }}
    {%- else -%}
      <img src="{{ 'tylt-logo.png' | asset_url }}" alt="{{ shop.name }}" width="395" height="170" loading="eager">
    {%- endif -%}
  </a>
</div>

<header id="tylt-masthead" class="tylt-header" role="banner">
  <div class="tylt-container">
    {%- unless is_home -%}
      <button class="tylt-menu-toggle" aria-controls="tylt-drawer-menu" aria-expanded="false" aria-label="Menu">
        <span class="tylt-menu-icon"></span>
      </button>
    {%- endunless -%}

    <nav id="tylt-site-navigation" class="tylt-main-navigation{% if is_home %} tylt-home-nav-wrap{% endif %}" role="navigation" aria-label="Menu principal">
      {%- if is_home -%}
        <ul class="tylt-home-nav">
          {%- for link in section.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </nav>

    {%- unless is_home -%}
      <div id="tylt-drawer-menu" class="tylt-menu-drawer">
        <ul class="tylt-drawer-nav">
          {%- for link in section.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>

        <div class="tylt-drawer-actions">
          {%- render 'tylt-hero-actions', vertical: false -%}
        </div>
      </div>

      <div class="tylt-hero-actions-sidebar">
        {%- render 'tylt-hero-actions', vertical: true -%}
      </div>
    {%- endunless -%}
  </div>
</header>

{% schema %}
{
  "name": "TYLT Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
